---
import { t, type Lang } from '../i18n/ui';
import { cv } from '../data/cv';

interface Props { lang: Lang }
const { lang } = Astro.props;
const l = t(lang);
---
<footer class="site-footer">
  <div class="container">
    <p class="site-footer-label">{l['cta.label']}</p>
    <h2 class="site-footer-title">{cv.cta.title[lang]}</h2>
    <p>{cv.cta.text[lang]}</p>
    <div class="site-footer-actions">
      <a class="button" href={`mailto:${cv.email}`}>{l['cta.email']} ↗</a>
      <a class="button button-ghost" href={cv.linkedin}>LinkedIn ↗</a>
    </div>
    <p class="site-footer-meta">© {new Date().getFullYear()} {cv.name}</p>
  </div>
</footer>
