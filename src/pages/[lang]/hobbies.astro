---
import Base from '../../layouts/Base.astro';
import { href, langPaths, t, type Lang } from '../../i18n/ui';
import { ct } from '../../scripts/coaching/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const title = t(lang)['nav.hobbies'];
const hobbies = [{ path: 'hobbies/coaching', title: ct(lang).title, desc: ct(lang).card }];
---
<Base lang={lang} title={title}>
  <h1>{title}</h1>
  <p class="muted">{t(lang)['hobbies.lede']}</p>
  <ul class="project-list">
    {hobbies.map((h) => (
      <li>
        <a href={href(lang, h.path)}>{h.title}</a>
        <p class="muted">{h.desc}</p>
      </li>
    ))}
  </ul>
</Base>
