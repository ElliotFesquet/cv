---
import Base from '../../../../layouts/Base.astro';
import { href, langPaths, type Lang } from '../../../../i18n/ui';
import { tt } from '../../../../scripts/typing/i18n';
import { texts, tutorial } from '../../../../data/typing';
import { bots } from '../../../../scripts/typing/bots';
import '../../../../styles/sql-arena.css';
import '../../../../styles/typing.css';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = tt(lang);
const modes = [
  { path: 'test', title: s.test, desc: s['test.desc'], count: texts.en.length + texts.fr.length, unit: s.texts },
  { path: 'versus', title: s.versus, desc: s['versus.desc'], count: bots.length, unit: s.opponents },
  { path: 'tutorial', title: s.tutorial, desc: s['tutorial.desc'], count: tutorial.length, unit: s.steps },
];
---
<Base lang={lang} title={s.title}>
  <section class="arena">
    <div class="arena-bar"><span>{s.press}</span><span><span class="arena-blink">●</span> {s.engine}</span></div>
    <h1 class="arena-title" data-type>{s.title}</h1>
    <p class="arena-lede" data-type data-type-delay="350">{s.lede}</p>
    <nav class="arena-menu" data-menu aria-label={s.title}>
      <ol>
        {modes.map((m, i) => (
          <li>
            <a href={href(lang, `apps/typing/${m.path}`)}>
              <span class="arena-idx">{String(i + 1).padStart(2, '0')}</span>
              <span class="arena-label" data-scramble>{m.title}</span>
              <span class="arena-meta">{m.count} {m.unit}</span>
              <span class="arena-desc">{m.desc}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <p class="arena-help">{s['menu.help']}</p>
  </section>
</Base>
<script>import '../../../../scripts/sql/fx';</script>
