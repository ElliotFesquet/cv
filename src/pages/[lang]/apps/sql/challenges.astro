---
import Base from '../../../../layouts/Base.astro';
import Header from '../../../../components/sql/Header.astro';
import Workbench from '../../../../components/sql/Workbench.astro';
import { langPaths, type Lang } from '../../../../i18n/ui';
import { st } from '../../../../scripts/sql/i18n';
import { challenges } from '../../../../data/sql';
import '../../../../styles/sql.css';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = st(lang);
---
<Base lang={lang} title={`${s.challenges} · ${s.title}`}>
  <Header lang={lang} title={s.challenges} desc={s['challenges.desc']} />
  <Workbench lang={lang} tasks={challenges} />
</Base>
